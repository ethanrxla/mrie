# MRE command center. Copy to the repository-root .env or to apps/web/.env.local.
# Never expose these values through NEXT_PUBLIC_ variables.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Single-workstation persistence. This creates an empty local store; no sample
# conversations, memories, events, objectives, agents, or appointments are seeded.
LOCAL_MODE=true
LOCAL_USER_EMAIL=operator@mre.local
# Optional override; the local launcher uses apps/web/.xyn/local-store.json.
# LOCAL_STORE_PATH=C:/path/to/private/local-store.json
ALLOW_REGISTRATION=false

# Production identity and persistence.
AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://xyn:xyn_dev_only@localhost:5432/xyn

# Docker Compose database settings. Use URL-safe random values; Compose builds
# DATABASE_URL with the internal `postgres` hostname from these fields.
POSTGRES_DB=xyn
POSTGRES_USER=xyn
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
WEB_PORT=3000

# Language model: mrie | openai-compatible | hermes
LLM_PROVIDER=mrie
# NVIDIA NIM is OpenAI-compatible. Existing NVIDIA_NIM_API_KEY is supported.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
LLM_API_KEY=
NVIDIA_NIM_API_KEY=

# Local MRE bridge. MRIE_RPC_* names are retained as legacy API compatibility.
# Keep loopback-only; the browser never connects directly.
MRIE_RPC_HOST=127.0.0.1
MRIE_RPC_PORT=17351

# Optional Hermes Agent bridge. Start Hermes with the same random token:
#   HERMES_DASHBOARD_SESSION_TOKEN=<token> hermes serve --host 127.0.0.1 --port 9119
# Keep the credential server-side; never rename it to NEXT_PUBLIC_*.
HERMES_GATEWAY_URL=ws://127.0.0.1:9119/api/ws
HERMES_GATEWAY_TOKEN=
HERMES_GATEWAY_PROFILE=
HERMES_GATEWAY_CWD=
# manual-required refuses to run if Hermes has approvals.mode=smart/off.
HERMES_APPROVAL_POLICY=manual-required
HERMES_CONNECT_TIMEOUT_MS=8000
HERMES_REQUEST_TIMEOUT_MS=120000

# Speech providers: browser | elevenlabs. Browser speech is the credential-free default.
STT_PROVIDER=browser
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional future semantic embedding and audio-object storage adapters.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
OBJECT_STORAGE_URL=

LOG_LEVEL=info
