# Copy this file to .env.compose and replace both blank secrets before running
# the full Compose stack. Never commit .env.compose.
POSTGRES_DB=xyn
POSTGRES_USER=xyn
POSTGRES_PASSWORD=
AUTH_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000
ALLOW_REGISTRATION=false
LOCAL_MODE=false
LOCAL_USER_EMAIL=operator@mre.local
LOCAL_STORE_PATH=/app/.xyn/local-store.json

LLM_PROVIDER=mrie
LLM_BASE_URL=
LLM_API_KEY=
NVIDIA_NIM_API_KEY=
LLM_MODEL=
MRIE_RPC_HOST=host.docker.internal
MRIE_RPC_PORT=17351

STT_PROVIDER=browser
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
OBJECT_STORAGE_URL=
LOG_LEVEL=info
