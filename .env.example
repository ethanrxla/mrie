# windows:mre-personal-assistant:0.1 (by /u/your_reddit_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=
ELEVENLABS_API_KEY=
TTS_PROVIDER=elevenlabs
STT_PROVIDER=browser
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Dedicated daemon audio directory. Relative paths resolve from the repository root.
MRE_SPEECH_STORAGE_DIR=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
